{
  "name": "expert-webs-designs-dashboard",
  "private": true,
  "version": "1.3.0",
  "description": "Expert Webs Designs — business dashboard (billing, parties, stock, accounts)",
  "author": "Expert Webs Designs",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --port 5199 --strictPort\" \"wait-on tcp:5199 && electron .\"",
    "electron:build": "vite build && electron-builder --win"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "vite": "^5.4.11",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.expertwebsdesigns.dashboard",
    "productName": "Expert Webs Designs",
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "44.8.0",
    "copyright": "Expert Webs Designs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "zip"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Expert Webs Designs"
    },
    "artifactName": "Expert-Webs-Designs-${version}-win.${ext}"
  }
}
